# Backend-only secrets and settings. Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
LOCAL_CONFIDENCE_THRESHOLD=0.70
MODEL_PATH=runs/household-yolo26n/weights/best.pt

# Optional
# INFERENCE_IMAGE_SIZE=480
# Use the ONNX model (no PyTorch import, less memory) with the .pt model as a fallback:
# MODEL_PATH=models/household-yolo26n.onnx
# FALLBACK_MODEL_PATH=models/household-yolo26n.pt
# INFERENCE_THREADS=1
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_IMAGE_MAX_SIDE=1024
# MAX_UPLOAD_MB=10
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated labels that count as household objects; "*" accepts all model labels.
# HOUSEHOLD_LABELS=bed,sofa,chair,table,tv

# ---- A2A agent (python -m app.a2a) ----
# Bind address. 127.0.0.1 = this laptop only (also right for `tailscale serve`).
# Binding to a Tailscale IP or 0.0.0.0 requires A2A_AUTH_TOKEN.
A2A_HOST=127.0.0.1
A2A_PORT=9100
# URL that OTHER machines use to reach this agent; it is advertised in the Agent Card.
# Never localhost when a remote agent will call you. Examples:
#   https://<machine>.<tailnet>.ts.net        (tailscale serve, recommended)
#   http://100.x.y.z:9100                     (direct bind to the Tailscale IP)
A2A_PUBLIC_URL=
# Shared secret callers send as "Authorization: Bearer <token>". Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Share it with your mentor privately (not in git, not in the Agent Card).
A2A_AUTH_TOKEN=

# ---- A2A test client (scripts/a2a_client.py) ----
# Agent to test against and its token (e.g. your mentor's agent).
# A2A_REMOTE_URL=https://mentor-laptop.<tailnet>.ts.net
# A2A_REMOTE_TOKEN=
